<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Cores Oficiais Ducks -->
    <Color x:Key="DucksYellowColor">#FFD60A</Color>
    <Color x:Key="DucksDarkColor">#1C1C1C</Color>
    <Color x:Key="DucksPurpleColor">#7C3AED</Color>
    <Color x:Key="DucksBlueColor">#2563EB</Color>
    <Color x:Key="DucksLightYellowColor">#FFF27D</Color>
    <Color x:Key="DucksWhiteColor">#FFFFFF</Color>
    <Color x:Key="DucksGreenColor">#92A519</Color>
    <Color x:Key="DucksRedColor">#FF5757</Color>
    <Color x:Key="DucksGrayBgColor">#F8FAFC</Color>

    <!-- Brushes Reutilizáveis -->
    <SolidColorBrush x:Key="DucksYellowBrush" Color="{StaticResource DucksYellowColor}"/>
    <SolidColorBrush x:Key="DucksDarkBrush" Color="{StaticResource DucksDarkColor}"/>
    <SolidColorBrush x:Key="DucksPurpleBrush" Color="{StaticResource DucksPurpleColor}"/>
    <SolidColorBrush x:Key="DucksBlueBrush" Color="{StaticResource DucksBlueColor}"/>
    <SolidColorBrush x:Key="DucksLightYellowBrush" Color="{StaticResource DucksLightYellowColor}"/>
    <SolidColorBrush x:Key="DucksWhiteBrush" Color="{StaticResource DucksWhiteColor}"/>
    <SolidColorBrush x:Key="DucksGreenBrush" Color="{StaticResource DucksGreenColor}"/>
    <SolidColorBrush x:Key="DucksRedBrush" Color="{StaticResource DucksRedColor}"/>
    <SolidColorBrush x:Key="DucksGrayBgBrush" Color="{StaticResource DucksGrayBgColor}"/>

</ResourceDictionary>