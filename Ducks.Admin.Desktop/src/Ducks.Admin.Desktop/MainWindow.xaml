<Window x:Class="Ducks.Admin.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ducks Admin Desktop - Painel de Controle" Height="720" Width="1200"
        Background="{StaticResource DucksGrayBgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar / Menu de Navegação Lateral -->
        <Border Background="#1C1C1C" Padding="20">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="🦆" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Ducks Admin" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Poppins" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botões de Navegação -->
                <Button Content="Dashboard" Style="{StaticResource DucksMenuButtonStyle}" Command="{Binding NavigateToDashboardCommand}" Margin="0,0,0,10"/>
                <Button Content="Usuários" Style="{StaticResource DucksMenuButtonStyle}" Command="{Binding NavigateToUsersCommand}" Margin="0,0,0,10"/>
                <Button Content="Moderação" Style="{StaticResource DucksMenuButtonStyle}" Command="{Binding NavigateToModerationCommand}" Margin="0,0,0,10"/>
                <Button Content="Cursos e Trilhas" Style="{StaticResource DucksMenuButtonStyle}" Command="{Binding NavigateToCoursesCommand}" Margin="0,0,0,10"/>
                <Button Content="Assistente IA" Style="{StaticResource DucksMenuButtonStyle}" Command="{Binding NavigateToAICommand}" Margin="0,0,0,10"/>
                <Button Content="Configurações" Style="{StaticResource DucksMenuButtonStyle}" Command="{Binding NavigateToSettingsCommand}" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <!-- Área Principal de Conteúdo -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <DockPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DucksDarkBrush}" FontFamily="Poppins" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusConexao}" FontSize="12" Foreground="#059669" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Conteúdo do Dashboard (Cards de Métricas e Gráficos Simulados) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Cartões de KPIs (Métricas) -->
                    <UniformGrid Columns="4" Margin="0,0,0,25">
                        <Border Style="{StaticResource DucksCardStyle}" Padding="20" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Total de Alunos" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalUsuarios}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DucksDarkBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="+12% este mês" FontSize="11" Foreground="#059669" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DucksCardStyle}" Padding="20" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Taxa de Engajamento" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TaxaEngajamento}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DucksPurpleBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="Alto desempenho" FontSize="11" Foreground="#059669" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DucksCardStyle}" Padding="20" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Moderação Pendente" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ModeracaoPendente}" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,0"/>
                                <TextBlock Text="Requer atenção" FontSize="11" Foreground="#D97706" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DucksCardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Trilhas Ativas" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CursosAtivos}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DucksDarkBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="Plataforma gamificada" FontSize="11" Foreground="{StaticResource DucksPurpleBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Seção de Gráficos e Atividade Recente (Estilo SaaS) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Gráfico de Crescimento Semanal (Simulado via Barras Visuais) -->
                        <Border Grid.Column="0" Style="{StaticResource DucksCardStyle}" Padding="25" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Desempenho Semanal da Plataforma Ducks" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DucksDarkBrush}" Margin="0,0,0,15"/>
                                <TextBlock Text="Evolução de acessos e conclusão de trilhas de aprendizado." FontSize="12" Foreground="#64748B" Margin="0,0,0,25"/>

                                <!-- Barras do Gráfico -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="150">
                                    <StackPanel Width="40" Margin="10,0" VerticalAlignment="Bottom">
                                        <Border Height="80" Background="{StaticResource DucksYellowBrush}" CornerRadius="4"/>
                                        <TextBlock Text="Seg" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Width="40" Margin="10,0" VerticalAlignment="Bottom">
                                        <Border Height="110" Background="{StaticResource DucksPurpleBrush}" CornerRadius="4"/>
                                        <TextBlock Text="Ter" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Width="40" Margin="10,0" VerticalAlignment="Bottom">
                                        <Border Height="95" Background="{StaticResource DucksYellowBrush}" CornerRadius="4"/>
                                        <TextBlock Text="Qua" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Width="40" Margin="10,0" VerticalAlignment="Bottom">
                                        <Border Height="130" Background="{StaticResource DucksPurpleBrush}" CornerRadius="4"/>
                                        <TextBlock Text="Qui" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Width="40" Margin="10,0" VerticalAlignment="Bottom">
                                        <Border Height="145" Background="{StaticResource DucksYellowBrush}" CornerRadius="4"/>
                                        <TextBlock Text="Sex" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Atividade de Auditoria Recente -->
                        <Border Grid.Column="1" Style="{StaticResource DucksCardStyle}" Padding="25">
                            <StackPanel>
                                <TextBlock Text="Auditoria Recente" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DucksDarkBrush}" Margin="0,0,0,15"/>
                                <TextBlock Text="Últimas ações administrativas." FontSize="12" Foreground="#64748B" Margin="0,0,0,15"/>

                                <Border Background="#F8FAFC" Padding="10" CornerRadius="6" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Usuário ativado" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Ana Silva (ID: 1)" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" Padding="10" CornerRadius="6" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Moderação revisada" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Item #2 aprovado" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" Padding="10" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Backup realizado" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Azure SQL Database" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>