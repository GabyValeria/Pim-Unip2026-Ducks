<UserControl x:Class="Ducks.Desktop.UI.Views.SimuladosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Listagem + questões do simulado -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FiltroBusca, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar no título">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding OpcoesStatus}" SelectedItem="{Binding FiltroStatus}" MinWidth="120" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Content="Buscar" Command="{Binding BuscarCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                </Grid>

                <ctl:StatusBanner Grid.Row="1" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProvaID}" Width="56"/>
                        <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                        <DataGridTextColumn Header="Questões" Binding="{Binding NumeroQuestoes}" Width="80"/>
                        <DataGridTextColumn Header="Nota mín." Binding="{Binding NotaMinimaAprovacao}" Width="80"/>
                        <DataGridTextColumn Header="XP" Binding="{Binding RecompensaXP}" Width="60"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,14,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0">
                        <Button Content="Editar" Command="{Binding EditarSimuladoCommand}" Margin="0,0,8,0"/>
                        <Button Content="Enviar para revisão" Command="{Binding EnviarRevisaoCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Excluir" Command="{Binding ExcluirCommand}" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Command="{Binding PaginaAnteriorCommand}" Width="40" Padding="0,8"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0" Style="{StaticResource MutedText}">
                            <Run Text="Página"/> <Run Text="{Binding Pagina, Mode=OneWay}"/> <Run Text="de"/> <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Content="›" Command="{Binding PaginaSeguinteCommand}" Width="40" Padding="0,8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="4" Text="Questões do simulado selecionado" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="5" ItemsSource="{Binding Questoes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ordem" Binding="{Binding Ordem}" Width="64"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding QuestaoID}" Width="56"/>
                        <DataGridTextColumn Header="Enunciado" Binding="{Binding Enunciado}" Width="*"/>
                        <DataGridTextColumn Header="Dificuldade" Binding="{Binding Dificuldade}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Formulário, seleção manual e sorteio -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Título (3 a 150 caracteres)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0,0,0,12"/>

                    <TextBlock Text="Descrição" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="ID da trilha" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TrilhaIdTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ID do módulo" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ModuloIdTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tempo limite (min, vazio = sem limite)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding TempoLimiteTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Máx. tentativas (vazio = ilimitado)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding MaxTentativasTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Nota mínima" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NotaMinimaTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="XP máximo" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RecompensaXpTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nº de questões" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NumeroQuestoesTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Salvar simulado" Command="{Binding SalvarCommand}" Style="{StaticResource PrimaryButton}" Padding="18,12"/>
                        <Button Content="Novo / limpar" Command="{Binding NovoSimuladoCommand}" Margin="10,0,0,0" Padding="18,12"/>
                    </StackPanel>

                    <Separator Margin="0,20,0,16" Opacity="0.4"/>
                    <TextBlock Text="Seleção manual de questões" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                    <TextBlock Text="IDs na ordem em que aparecerão (ex.: 12, 15, 20)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding QuestaoIdsTexto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="64" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
                    <Button Content="Definir questões do simulado selecionado" Command="{Binding DefinirQuestoesCommand}" HorizontalAlignment="Left"/>

                    <Separator Margin="0,20,0,16" Opacity="0.4"/>
                    <TextBlock Text="Sorteio entre questões aprovadas" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Quantidade (vazio = nº do simulado)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding SorteioQuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dificuldade" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding OpcoesDificuldadeSorteio}" SelectedItem="{Binding SorteioDificuldade}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tag" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SorteioTag, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Assunto" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SorteioAssunto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Substituir as questões atuais (desmarque para acrescentar ao final)" IsChecked="{Binding SorteioSubstituir}" Margin="0,0,0,12"/>
                    <Button Content="Sortear questões" Command="{Binding SortearCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
