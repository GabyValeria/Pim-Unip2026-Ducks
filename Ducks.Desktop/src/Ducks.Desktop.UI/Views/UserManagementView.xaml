<UserControl x:Class="Ducks.Desktop.UI.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filtros -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Busque por nome ou e-mail e pressione Enter">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PesquisarCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Pesquisar" Style="{StaticResource PrimaryButton}" Command="{Binding PesquisarCommand}" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Papel:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="22,0,8,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding OpcoesFiltroPapeis}" SelectedItem="{Binding FiltroPapelSelecionado}" MinWidth="150"/>
                <Button Grid.Column="4" Content="Atualizar" Command="{Binding AtualizarCommand}" Margin="10,0,0,0"/>
            </Grid>

            <ctl:StatusBanner Grid.Row="1" Margin="0,0,0,12"/>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding SelectedUsuario}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UsuarioID}" Width="70"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding NomeUsuario}" Width="1.2*"/>
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.5*"/>
                    <DataGridTextColumn Header="Papéis" Binding="{Binding RolesDisplay}" Width="1*"/>
                    <DataGridTextColumn Header="Cadastro" Binding="{Binding CriadoEm, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ações" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button CommandParameter="{Binding}" Padding="14,6"
                                        Command="{Binding DataContext.AlternarBloqueioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                            <Setter Property="Content" Value="Bloquear"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Content" Value="Desbloquear"/>
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Paginação -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TextoPaginacao}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="‹ Anterior" Command="{Binding PaginaAnteriorCommand}"/>
                <Button Grid.Column="2" Content="Próxima ›" Command="{Binding ProximaPaginaCommand}" Margin="8,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
