<UserControl x:Class="Ducks.Desktop.UI.Views.RoleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- Usuários -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Busque por nome ou e-mail e pressione Enter">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PesquisarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Pesquisar" Style="{StaticResource PrimaryButton}" Command="{Binding PesquisarCommand}" Margin="10,0,0,0"/>
                </Grid>

                <ctl:StatusBanner Grid.Row="1" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding SelectedUsuario}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UsuarioID}" Width="60"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding NomeUsuario}" Width="1*"/>
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.2*"/>
                        <DataGridTextColumn Header="Papéis atuais" Binding="{Binding RolesDisplay}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Atribuição -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Atribuir papel" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>

                <TextBlock Text="Usuário selecionado" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding SelectedUsuario.NomeUsuario, FallbackValue='Nenhum usuário selecionado'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

                <TextBlock Text="Novo papel" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Papeis}" SelectedItem="{Binding SelectedPapel}" DisplayMemberPath="NomePapel" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SelectedPapel.Descricao}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>

                <TextBlock Text="Atenção: o papel escolhido substitui todos os papéis atuais do usuário." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,16"/>

                <Button Content="Atribuir papel" Style="{StaticResource PrimaryButton}" Command="{Binding AtribuirPapelCommand}" Padding="18,12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
