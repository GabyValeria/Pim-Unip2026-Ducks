<UserControl x:Class="Ducks.Desktop.UI.Views.MetricsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ctl:StatusBanner Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="1" Content="Atualizar" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AtualizarCommand}" VerticalAlignment="Top"/>
            </Grid>

            <!-- Indicadores -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="32,26" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total de Usuários" Style="{StaticResource MutedText}" FontSize="16"/>
                        <TextBlock Text="{Binding TotalUsuariosTexto}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,12"/>
                        <Border Style="{StaticResource PillGreen}">
                            <TextBlock Text="{Binding UsuariosAtivosPill}" Style="{StaticResource PillText}" Foreground="#166534"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="32,26" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Aulas Cadastradas" Style="{StaticResource MutedText}" FontSize="16"/>
                        <TextBlock Text="{Binding TotalAulasTexto}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,12"/>
                        <Border Style="{StaticResource PillBlue}">
                            <TextBlock Text="{Binding TrilhasPill}" Style="{StaticResource PillText}" Foreground="#1E40AF"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="32,26" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Pendências de Moderação" Style="{StaticResource MutedText}" FontSize="16"/>
                        <TextBlock Text="{Binding PendenciasTexto}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,12"/>
                        <Border Style="{StaticResource PillAmber}">
                            <TextBlock Text="{Binding PendenciasPill}" Style="{StaticResource PillText}" Foreground="#92400E"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Gráfico + permissões -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="32,28" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Visão da Plataforma" Style="{StaticResource SectionTitleText}" FontSize="22"/>
                        <TextBlock Text="{Binding XpDistribuidoTexto}" Style="{StaticResource MutedText}" Margin="0,2,0,16"/>

                        <ItemsControl ItemsSource="{Binding Barras}" Height="330">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="8,0">
                                        <TextBlock Text="{Binding ValorTexto}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                        <Border Height="{Binding Altura}" Background="{StaticResource BarBrush}" CornerRadius="20,20,0,0"/>
                                        <TextBlock Text="{Binding Rotulo}" HorizontalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource SoftTextBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="28" Margin="12,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Controle de Permissões" Style="{StaticResource SectionTitleText}" FontSize="22" Margin="0,0,0,18"/>
                        <ItemsControl ItemsSource="{Binding Papeis}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="20" Padding="16,14" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NomePapel}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Descricao}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
