<Window x:Class="Ducks.Desktop.UI.Views.PromptMotivoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmação" Width="460" SizeToContent="Height" MinHeight="260"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}"
        ShowInTaskbar="False">
    <Border Style="{StaticResource CardStyle}" Margin="18" Padding="26">
        <StackPanel>
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtMensagem" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

            <TextBox x:Name="TxtTexto" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="500"/>

            <TextBlock x:Name="TxtErro" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="2,8,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" IsCancel="True" Click="Cancelar_Click" MinWidth="100" Margin="0,0,10,0"/>
                <Button x:Name="BtnConfirmar" Style="{StaticResource DangerButton}" IsDefault="False"
                        Click="Confirmar_Click" MinWidth="160"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
