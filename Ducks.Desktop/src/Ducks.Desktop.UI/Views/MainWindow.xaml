<Window x:Class="Ducks.Desktop.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ducks.Desktop.UI.Views"
        xmlns:appvm="clr-namespace:Ducks.Desktop.Application.ViewModels;assembly=Ducks.Desktop.Application"
        Title="{Binding Title}" Width="1366" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type appvm:MetricsDashboardViewModel}"><views:MetricsDashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:UserManagementViewModel}"><views:UserManagementView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:ModerationViewModel}"><views:ModerationView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:CoursesAndTrailsViewModel}"><views:CoursesAndTrailsView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:ContentStructureViewModel}"><views:ContentStructureView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:QuestionBankViewModel}"><views:QuestionBankView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:SimuladosViewModel}"><views:SimuladosView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:XpAdjustmentViewModel}"><views:XpAdjustmentView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:GamificationManagementViewModel}"><views:GamificationManagementView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:AiAutomationViewModel}"><views:AiAutomationView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:AuditLogsViewModel}"><views:AuditLogsView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:PlatformSettingsViewModel}"><views:PlatformSettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type appvm:RoleManagementViewModel}"><views:RoleManagementView/></DataTemplate>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Avatar circular (clique = sair) -->
        <Style x:Key="AvatarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Menu lateral ========== -->
        <Border Grid.Column="0" Background="White">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="pack://application:,,,/Ducks.Desktop.UI;component/Assets/logo.png"
                       Height="56" Stretch="Uniform" HorizontalAlignment="Left" Margin="6,0,0,28"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarVisaoGeralCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=MetricsDashboardViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;"/><TextBlock Text="Visão Geral"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarUsuariosCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=UserManagementViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE716;"/><TextBlock Text="Usuários"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarCursosTrilhasCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=CoursesAndTrailsViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8F1;"/><TextBlock Text="Cursos e Trilhas"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarModulosAulasCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=ContentStructureViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8FD;"/><TextBlock Text="Módulos e Aulas"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarQuestoesCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=QuestionBankViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE897;"/><TextBlock Text="Banco de Questões"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarSimuladosCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=SimuladosViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE7C3;"/><TextBlock Text="Simulados"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarPermissoesCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=RoleManagementViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE72E;"/><TextBlock Text="Permissões"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarModeracaoCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=ModerationViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE7BA;"/><TextBlock Text="Moderação"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarXpMedalhasCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=GamificationManagementViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE734;"/><TextBlock Text="XP e Medalhas"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarAjusteXpCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=XpAdjustmentViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE735;"/><TextBlock Text="Ajuste de XP"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarAssistenteIaCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=AiAutomationViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8BD;"/><TextBlock Text="Assistente de IA"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarParametrosCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=PlatformSettingsViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;"/><TextBlock Text="Parâmetros"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" Command="{Binding NavegarAuditoriaLogsCommand}"
                                     IsChecked="{Binding ModuloAtivo, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=AuditLogsViewModel}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;"/><TextBlock Text="Relatórios"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== Conteúdo ========== -->
        <Grid Grid.Column="1" Margin="36,38,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho com título, busca e avatar -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="36,24" Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TituloPagina}" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="{Binding SubtituloPagina}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="340" Margin="20,0,24,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}" MinHeight="58"
                                 Padding="22,0" FontSize="14">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PesquisarUsuarioCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Pesquisar usuário..." Foreground="{StaticResource SoftTextBrush}" FontSize="14"
                                   Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TermoBusca}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource AvatarButton}" Content="{Binding InicialUsuario}"
                            Command="{Binding SairCommand}" ToolTip="Sair da conta"/>
                </Grid>
            </Border>

            <!-- Módulo atual -->
            <ContentControl Grid.Row="1" Content="{Binding ViewModelAtual}"/>
        </Grid>
    </Grid>
</Window>
