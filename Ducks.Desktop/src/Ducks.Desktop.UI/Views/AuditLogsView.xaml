<UserControl x:Class="Ducks.Desktop.UI.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtre por usuário, ação ou detalhes"/>
                    <TextBlock Text="Filtrar por usuário, ação ou detalhes..." Foreground="{StaticResource SoftTextBrush}"
                               FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FiltroTermo}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="2" Content="Atualizar" Command="{Binding AtualizarCommand}"/>
            </Grid>

            <ctl:StatusBanner Grid.Row="1" Margin="0,0,0,12"/>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding LogID}" Width="70"/>
                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="170"/>
                    <DataGridTextColumn Header="Usuário (ID)" Binding="{Binding Usuario}" Width="110"/>
                    <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="1.2*"/>
                    <DataGridTextColumn Header="Detalhes" Binding="{Binding Detalhes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
