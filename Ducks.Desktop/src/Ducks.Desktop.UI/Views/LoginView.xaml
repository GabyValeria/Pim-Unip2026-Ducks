<Window x:Class="Ducks.Desktop.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ducks Admin - Login" Width="480" Height="680" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>

    <Grid Margin="36">
        <Border Style="{StaticResource CardStyle}" Padding="36,32">
            <StackPanel VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Ducks.Desktop.UI;component/Assets/logo.png"
                       Height="72" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,28"/>

                <TextBlock Text="Bem-vindo de volta!" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Continue sua gestão no Ducks Admin." Style="{StaticResource MutedText}" Margin="0,4,0,24"/>

                <Border Background="#FEF2F2" CornerRadius="14" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding MensagemErro}" Foreground="#B91C1C" FontSize="13"
                               FontWeight="Medium" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16"/>

                <TextBlock Text="Senha" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,26" PasswordChanged="PasswordBox_PasswordChanged"/>

                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" BorderThickness="0"
                             Background="#E5E7EB" Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <Button Content="Entrar no Sistema" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" Padding="18,14" FontSize="14"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
