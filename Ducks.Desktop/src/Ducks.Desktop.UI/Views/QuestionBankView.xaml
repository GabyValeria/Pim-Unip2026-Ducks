<UserControl x:Class="Ducks.Desktop.UI.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- Listagem -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FiltroBusca, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar no enunciado">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding OpcoesStatus}" SelectedItem="{Binding FiltroStatus}" MinWidth="120" Margin="10,0,0,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding OpcoesDificuldadeFiltro}" SelectedItem="{Binding FiltroDificuldade}" MinWidth="110" Margin="10,0,0,0"/>
                    <Button Grid.Column="3" Content="Buscar" Command="{Binding BuscarCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                </Grid>

                <ctl:StatusBanner Grid.Row="1" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding QuestaoID}" Width="56"/>
                        <DataGridTextColumn Header="Enunciado" Binding="{Binding Enunciado}" Width="*"/>
                        <DataGridTextColumn Header="Dificuldade" Binding="{Binding Dificuldade}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0">
                        <Button Content="Editar" Command="{Binding EditarQuestaoCommand}" Margin="0,0,8,0"/>
                        <Button Content="Enviar para revisão" Command="{Binding EnviarRevisaoCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Excluir" Command="{Binding ExcluirCommand}" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Command="{Binding PaginaAnteriorCommand}" Width="40" Padding="0,8"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0" Style="{StaticResource MutedText}">
                            <Run Text="Página"/> <Run Text="{Binding Pagina, Mode=OneWay}"/> <Run Text="de"/> <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
                            <Run Text="·"/> <Run Text="{Binding TotalItens, Mode=OneWay}"/> <Run Text="questões"/>
                        </TextBlock>
                        <Button Content="›" Command="{Binding PaginaSeguinteCommand}" Width="40" Padding="0,8"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Formulário -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Enunciado" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Enunciado, UpdateSourceTrigger=PropertyChanged}" MaxLength="10000"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding OpcoesTipo}" SelectedItem="{Binding Tipo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Dificuldade" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding OpcoesDificuldade}" SelectedItem="{Binding Dificuldade}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Peso" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PesoTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Assunto" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Assunto, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0,0,0,12"/>

                    <TextBlock Text="Tags (separadas por vírgula, no máximo 10)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding TagsTexto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="ID da trilha" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TrilhaIdTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="ID do módulo" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ModuloIdTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ID da aula" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AulaIdTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Explicação geral da resposta" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ExplicacaoGeral, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alternativas (marque as corretas)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Adicionar" Command="{Binding AdicionarAlternativaCommand}" Padding="12,6"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Alternativas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Correta}" VerticalAlignment="Top" Margin="0,12,12,0" ToolTip="Alternativa correta"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Margin="0,0,0,6" ToolTip="Texto da alternativa"/>
                                            <TextBox Text="{Binding Explicacao, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" ToolTip="Por que está certa ou errada (opcional)"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Margin="8,0,0,0" VerticalAlignment="Top" Padding="10,8"
                                                ToolTip="Remover alternativa"
                                                Command="{Binding DataContext.RemoverAlternativaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Salvar questão" Command="{Binding SalvarCommand}" Style="{StaticResource PrimaryButton}" Padding="18,12"/>
                        <Button Content="Nova / limpar" Command="{Binding NovaQuestaoCommand}" Margin="10,0,0,0" Padding="18,12"/>
                    </StackPanel>
                    <TextBlock Text="Questões novas ou editadas ficam em RASCUNHO até serem enviadas para revisão." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
