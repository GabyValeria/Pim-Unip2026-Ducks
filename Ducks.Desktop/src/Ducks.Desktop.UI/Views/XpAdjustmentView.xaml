<UserControl x:Class="Ducks.Desktop.UI.Views.XpAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Border Style="{StaticResource CardStyle}" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Ajustar XP de um usuário" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>
            <TextBlock Text="Use um valor positivo para conceder XP e negativo para remover. O motivo fica registrado na auditoria."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <TextBlock Text="ID do usuário" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding UsuarioIdTexto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="Quantidade de XP (-10000 a 10000)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="Motivo (3 a 250 caracteres)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" MaxLength="250"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

            <ctl:StatusBanner Margin="0,0,0,14"/>

            <Button Content="Aplicar ajuste" Command="{Binding AplicarCommand}" Style="{StaticResource PrimaryButton}" Padding="18,12" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>
