<UserControl x:Class="Ducks.Desktop.UI.Views.AiAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ducks.Desktop.UI.Controls"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Entrada -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Solicitação" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>

                <TextBlock Grid.Row="1" Text="Tarefa" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="2" ItemsSource="{Binding TarefasDisponiveis}" SelectedItem="{Binding TarefaSelecionada}" Margin="0,6,0,14"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Contexto / dados para análise" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ContadorContexto}" Style="{StaticResource MutedText}" FontSize="12"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding ContextoEntrada, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <ctl:StatusBanner Grid.Row="4" Margin="0,14,0,0"/>

                <Button Grid.Row="5" Content="Executar assistente" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="18,12"
                        Command="{Binding ExecutarAssistenteCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
            </Grid>
        </Border>

        <!-- Resultado -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Resultado" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>

                <Grid Grid.Row="1">
                    <TextBox Text="{Binding ResultadoIa, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="O resultado da análise aparecerá aqui."
                               Foreground="{StaticResource SoftTextBrush}" Margin="16,12" IsHitTestVisible="False"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PossuiResultado}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Copiar" Command="{Binding CopiarResultadoCommand}" Margin="0,0,8,0"/>
                    <Button Content="Salvar relatório" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarRelatorioCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
