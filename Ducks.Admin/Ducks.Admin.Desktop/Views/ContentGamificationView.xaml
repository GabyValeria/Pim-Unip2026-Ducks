<UserControl x:Class="Ducks.Admin.Desktop.Views.ContentGamificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950"
             Background="{StaticResource DucksBackgroundBrush}">
    <Grid Margin="25">
        <TabControl Background="{StaticResource DucksSurfaceBrush}" Foreground="{StaticResource DucksWhiteBrush}" BorderBrush="{StaticResource DucksCardBrush}">
            
            <!-- ABA 1: GERENCIAMENTO DE TRILHAS E CONTEÚDO -->
            <TabItem Header=" Trilhas de Aprendizagem " Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Trilhas}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="{StaticResource DucksCardBrush}" Foreground="{StaticResource DucksWhiteBrush}" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding TrilhaId}" Width="50"/>
                            <DataGridTextColumn Header="Nome da Trilha" Binding="{Binding NomeTrilha}" Width="250"/>
                            <DataGridTextColumn Header="Matéria ID" Binding="{Binding MateriaId}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTemplateColumn Header="Ações" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Aprovar Trilha" 
                                                Command="{Binding DataContext.AprovarTrilhaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Height="28" Width="110" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Formulário Rápido para Criar Trilha -->
                    <Border Grid.Row="1" Background="{StaticResource DucksCardBrush}" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Cadastrar Nova Trilha" FontWeight="Bold" Foreground="{StaticResource DucksYellowBrush}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <TextBox Text="{Binding NovaTrilhaNome, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="35" Margin="0,0,10,10"/>
                                <TextBox Text="{Binding NovaTrilhaDescricao, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="35" Margin="0,0,10,10"/>
                                <Button Content="Criar Trilha" Command="{Binding CriarTrilhaCommand}" Width="120" Height="35"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 2: GAMIFICAÇÃO E CONQUISTAS -->
            <TabItem Header=" Gamificação &amp; Conquistas " Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Conquistas}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="{StaticResource DucksCardBrush}" Foreground="{StaticResource DucksWhiteBrush}" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ConquistaId}" Width="50"/>
                            <DataGridTextColumn Header="Título da Medalha" Binding="{Binding Titulo}" Width="200"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="300"/>
                            <DataGridTextColumn Header="XP Necessário" Binding="{Binding XpNecessario}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Formulário Rápido para Criar Conquista -->
                    <Border Grid.Row="1" Background="{StaticResource DucksCardBrush}" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Configurar Nova Conquista / Medalha" FontWeight="Bold" Foreground="{StaticResource DucksYellowBrush}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <TextBox Text="{Binding NovaConquistaTitulo, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="35" Margin="0,0,10,10"/>
                                <TextBox Text="{Binding NovaConquistaDescricao, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="35" Margin="0,0,10,10"/>
                                <TextBox Text="{Binding NovoXpNecessario, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="35" Margin="0,0,10,10"/>
                                <Button Content="Criar Conquista" Command="{Binding CriarConquistaCommand}" Width="130" Height="35"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>