classDiagram
    class MainViewModel {
        +NavigationStore navigationStore
        +ObservableObject CurrentViewModel
    }
    class LoginViewModel {
        +IAuthApiService authApiService
        +UserSessionStore userSessionStore
        +NavigationStore navigationStore
        +string Email
        +string Senha
        +LoginAsync()
    }
    class UserManagementViewModel {
        +IAdminApiService adminApiService
        +ObservableCollection~UsuarioAdminDto~ Usuarios
        +CarregarUsuariosAsync()
        +AlternarStatusAsync()
    }
    class ContentGamificationViewModel {
        +IAdminApiService adminApiService
        +ObservableCollection~TrilhaAdminDto~ Trilhas
        +ObservableCollection~ConquistaAdminDto~ Conquistas
        +CarregarDadosAsync()
        +AprovarTrilhaAsync()
    }
    class AiAssistantViewModel {
        +IAdminApiService adminApiService
        +AdminRealtimeService realtimeService
        +ObservableCollection~AuditLogDto~ LogsAuditoria
        +EnviarPromptAsync()
    }
    class UserSessionStore {
        +string JwtToken
        +string AdminEmail
        +bool IsLoggedIn
        +SetSession()
        +ClearSession()
    }
    class NavigationStore {
        +ObservableObject CurrentViewModel
    }
    class AdminRealtimeService {
        +ConnectAsync()
        +MetricUpdated event
        +AuditLogReceived event
    }

    MainViewModel --> NavigationStore
    LoginViewModel --> UserSessionStore
    LoginViewModel --> NavigationStore
    UserManagementViewModel --> IAdminApiService
    ContentGamificationViewModel --> IAdminApiService
    AiAssistantViewModel --> IAdminApiService
    AiAssistantViewModel --> AdminRealtimeService