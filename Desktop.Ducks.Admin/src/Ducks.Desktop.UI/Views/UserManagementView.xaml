<UserControl x:Class="Ducks.Desktop.UI.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FC">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho & Filtros -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="👥 Gestão de Usuários" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Listagem de cadastros, auditoria de acessos e bloqueio/desbloqueio de contas." FontSize="14" Foreground="#64748B" Margin="0,4,0,15"/>
            
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="38" Padding="10,8" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Perfil:" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                <ComboBox ItemsSource="{Binding OpcoesFiltroPapeis}" SelectedItem="{Binding FiltroPapelSelecionado}" Width="150" Height="38" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                <Button Content="🔄 Atualizar Lista" Command="{Binding CarregarUsuariosCommand}" Width="140" Height="38" Background="#FACC15" Foreground="#1E293B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="{Binding MensagemStatus}" FontSize="13" Foreground="#059669" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- DataGrid com identidade visual limpa (Light Theme) -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding SelectedUsuario}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Background="White" Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1" RowBackground="White" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UsuarioID}" Width="60"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding NomeUsuario}" Width="220"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="280"/>
                <DataGridTextColumn Header="Função" Binding="{Binding Role}" Width="120"/>
                <DataGridCheckBoxColumn Header="Bloqueado" Binding="{Binding IsBlocked}" Width="90"/>
                <DataGridTemplateColumn Header="Ações de Segurança" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Alternar Bloqueio" Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" Padding="8,4" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>