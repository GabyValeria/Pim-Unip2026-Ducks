<UserControl x:Class="Ducks.Desktop.UI.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FC">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📋 Auditoria de Logs" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Rastreabilidade de ações administrativas e eventos críticos do sistema." FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Barra de Busca e Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}" Width="320" Height="38" Padding="10,8" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center" ToolTip="Buscar por usuário, ação ou detalhe..."/>
            
            <Button Content="🔄 Atualizar Logs" Command="{Binding CarregarLogsCommand}" Width="150" Height="38" Margin="15,0,0,0" Background="#FACC15" Foreground="#1E293B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
            <TextBlock Text="{Binding MensagemStatus}" FontSize="13" Foreground="#059669" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Tabela DataGrid de Logs -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Background="White" Foreground="#1E293B" 
                  BorderBrush="#E2E8F0" BorderThickness="1" RowBackground="White" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding LogID}" Width="60"/>
                <DataGridTextColumn Header="Data / Hora" Binding="{Binding DataHora, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" Width="160"/>
                <DataGridTextColumn Header="Usuário / Operador" Binding="{Binding Usuario}" Width="200"/>
                <DataGridTextColumn Header="Ação Executada" Binding="{Binding Acao}" Width="180"/>
                <DataGridTextColumn Header="Detalhes da Ocorrência" Binding="{Binding Detalhes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>