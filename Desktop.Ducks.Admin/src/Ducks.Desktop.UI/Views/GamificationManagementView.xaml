<UserControl x:Class="Ducks.Desktop.UI.Views.GamificationManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🏆 Gestão de Gamificação, XP &amp; Medalhas" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Administre conquistas, regras de badges e atribua XP manualmente aos usuários." FontSize="14" Foreground="#64748B" Margin="0,4,0,15"/>
                <Button Content="Atualizar Dados" Command="{Binding CarregarDadosCommand}" Width="140" Height="38" Background="#FACC15" Foreground="#1E293B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,20">
                <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🏅 Catálogo de Conquistas (Badges)" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Badges}" AutoGenerateColumns="False" CanUserAddRows="False" Height="200" Background="Transparent" Foreground="#1E293B" BorderBrush="#E2E8F0" RowBackground="#FFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="200"/>
                                <DataGridTextColumn Header="XP" Binding="{Binding XpReward}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="10,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🎯 Desafios Ativos" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Desafios}" AutoGenerateColumns="False" CanUserAddRows="False" Height="200" Background="Transparent" Foreground="#1E293B" BorderBrush="#E2E8F0" RowBackground="#FFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="180"/>
                                <DataGridTextColumn Header="Recompensa" Binding="{Binding RewardXp}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚡ Bonificação Manual de XP" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,15">
                            <TextBlock Text="ID Usuário" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TargetUsuarioId, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="38" Padding="10" Background="#F8F9FC" Foreground="#1E293B" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,15">
                            <TextBlock Text="Qtd XP" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding QuantidadeXpAjuste, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="38" Padding="10" Background="#F8F9FC" Foreground="#1E293B" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,15">
                            <TextBlock Text="Motivo" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MotivoAjuste, UpdateSourceTrigger=PropertyChanged}" Width="280" Height="38" Padding="10" Background="#F8F9FC" Foreground="#1E293B" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                        <Button Content="Aplicar XP" Command="{Binding AjustarXpCommand}" Width="130" Height="38" Margin="0,18,0,0" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding MensagemStatus}" FontSize="13" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>