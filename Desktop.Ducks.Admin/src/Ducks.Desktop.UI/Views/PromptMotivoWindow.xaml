<Window x:Class="Ducks.Desktop.UI.Views.PromptMotivoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmação de Bloqueio" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#12141A">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="TxtTitulo" Text="Tem certeza que deseja bloquear este usuário?" FontSize="15" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="Informe o motivo do bloqueio:" FontSize="13" Foreground="#8F96A3" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMotivo" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Background="#1D212C" Foreground="White" BorderBrush="#2D3343" Padding="6" Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click" Width="90" Height="32" Background="#2D3343" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="Confirmar Bloqueio" Click="Confirmar_Click" Width="140" Height="32" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>