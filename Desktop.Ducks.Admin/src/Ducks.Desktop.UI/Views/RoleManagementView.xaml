<UserControl x:Class="Ducks.Desktop.UI.Views.RoleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🔑 Gestão de Permissões e Acessos (RBAC)" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Gerencie os papéis lógicos atribuídos a cada operador ou estudante do sistema de forma segura." FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Tabela DataGrid de Usuários e Acessos -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding SelectedUsuario}"
                      AutoGenerateColumns="False" CanUserAddRows="False" Background="White" Foreground="#1E293B" 
                      BorderBrush="#E2E8F0" BorderThickness="1" RowBackground="White" AlternatingRowBackground="#F8FAFC" 
                      Height="380" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UsuarioID}" Width="60"/>
                    <DataGridTextColumn Header="Nome do Usuário" Binding="{Binding NomeUsuario}" Width="220"/>
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="280"/>
                    <DataGridTextColumn Header="Papel Atual" Binding="{Binding Role}" Width="150"/>
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding EstaAtivo}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Rodapé de Ações & Atribuição de Papel -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                <DockPanel LastChildFill="False">
                    <!-- Seletor de Papel -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Novo Papel:" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Papeis}" SelectedItem="{Binding SelectedPapel}" DisplayMemberPath="NomePapel" Width="200" Height="38" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                        
                        <!-- Botões de Ação -->
                        <Button Content="🛡️ Atribuir Papel ao Usuário" Command="{Binding AtribuirPapelCommand}" Height="38" Padding="15,0" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Content="🔄 Atualizar" Command="{Binding CarregarDadosCommand}" Height="38" Padding="12,0" Background="#F1F5F9" Foreground="#1E293B" FontWeight="Bold" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Mensagem de Feedback -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMensagem}" FontSize="13" Foreground="#059669" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="300" TextWrapping="Wrap" TextAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>