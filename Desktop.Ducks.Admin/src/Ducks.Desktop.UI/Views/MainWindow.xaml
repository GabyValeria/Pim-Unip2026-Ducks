<Window x:Class="Ducks.Desktop.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ducks.Desktop.UI.Views"
        xmlns:appvm="clr-namespace:Ducks.Desktop.Application.ViewModels;assembly=Ducks.Desktop.Application"
        Title="{Binding Title}" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F8F9FC">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type appvm:MetricsDashboardViewModel}">
            <views:MetricsDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:ModerationViewModel}">
            <views:ModerationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:CoursesAndTrailsViewModel}">
            <views:CoursesAndTrailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:GamificationManagementViewModel}">
            <views:GamificationManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:AiAutomationViewModel}">
            <views:AiAutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:AuditLogsViewModel}">
            <views:AuditLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:PlatformSettingsViewModel}">
            <views:PlatformSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appvm:RoleManagementViewModel}">
            <views:RoleManagementView />
        </DataTemplate>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Light Mode -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,35" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Ducks.Desktop.UI;component/Assets/logo.png" Height="60" Stretch="Uniform"/>
                </StackPanel>

                <Button Content="📊 Visão Geral / Métricas" Command="{Binding NavegarVisaoGeralCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="👥 Gerenciar Usuários" Command="{Binding NavegarUsuariosCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="🛡️ Fila de Moderação" Command="{Binding NavegarModeracaoCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="📚 Cursos &amp; Trilhas" Command="{Binding NavegarCursosTrilhasCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="🏆 XP &amp; Medalhas" Command="{Binding NavegarXpMedalhasCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="⚙️ Parâmetros Globais" Command="{Binding NavegarParametrosCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="🔑 Gestão de Permissões" Command="{Binding NavegarPermissoesCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="🤖 Assistente IA" Command="{Binding NavegarAssistenteIaCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                <Button Content="📋 Auditoria de Logs" Command="{Binding NavegarAuditoriaLogsCommand}" Style="{StaticResource SidebarButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="#F8F9FC">
            <ContentControl Content="{Binding ViewModelAtual}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🦆 Bem-vindo ao Ducks Admin" FontSize="24" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Selecione um módulo no menu lateral para gerenciar a plataforma." FontSize="14" Foreground="#64748B" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</Window>