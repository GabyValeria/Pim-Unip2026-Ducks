<UserControl x:Class="Ducks.Desktop.UI.Views.CoursesAndTrailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="📚 Cursos &amp; Trilhas" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Administração de conteúdos educacionais, módulos e trilhas de aprendizagem." FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Cards de Métricas no Topo -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,25">
                <!-- Card 1: Total de Trilhas -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Total de Trilhas" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalTrilhas}" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,4"/>
                        <TextBlock Text="🗺️ Jornadas estruturadas" FontSize="12" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Cursos (Módulos) -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Cursos &amp; Módulos" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalCursos}" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,4"/>
                        <TextBlock Text="📂 Subdivisões de ensino" FontSize="12" Foreground="#D97706"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Atividades (Aulas) -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Atividades &amp; Aulas" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalAtividades}" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,4"/>
                        <TextBlock Text="📝 Unidades práticas" FontSize="12" Foreground="#059669"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Barra de Filtros e Ações -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="38" Padding="10,8" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center" ToolTip="Pesquisar por nome ou matéria..."/>
                
                <TextBlock Text="Status:" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                <ComboBox ItemsSource="{Binding OpcoesStatus}" SelectedItem="{Binding FiltroStatusSelecionado}" Width="140" Height="38" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                <Button Content="🔄 Atualizar Catálogo" Command="{Binding CarregarDadosCommand}" Width="160" Height="38" Background="#FACC15" Foreground="#1E293B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="{Binding MensagemStatus}" FontSize="13" Foreground="#059669" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <!-- Tabela Detalhada (DataGrid) -->
            <DataGrid Grid.Row="3" ItemsSource="{Binding Itens}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" CanUserAddRows="False" Background="White" Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1" RowBackground="White" AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding TrilhaID}" Width="60"/>
                    <DataGridTextColumn Header="Nome da Trilha" Binding="{Binding NomeTrilha}" Width="280"/>
                    <DataGridTextColumn Header="Matéria / Área" Binding="{Binding Materia}" Width="220"/>
                    <DataGridTextColumn Header="Módulos" Binding="{Binding TotalModulos}" Width="90"/>
                    <DataGridTextColumn Header="Atividades" Binding="{Binding TotalAtividades}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</UserControl>