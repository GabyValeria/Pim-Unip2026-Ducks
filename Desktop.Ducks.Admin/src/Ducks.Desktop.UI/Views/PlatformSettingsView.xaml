<UserControl x:Class="Ducks.Desktop.UI.Views.PlatformSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FC">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚙️ Parâmetros Globais da Plataforma" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Altere regras operacionais e limites globais da plataforma em tempo de execução." FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding MensagemFeedback}" FontSize="13" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Lista de Parâmetros -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Parametros}" SelectedItem="{Binding SelectedParametro}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Chave do Parâmetro" Binding="{Binding Chave}" Width="300"/>
                <DataGridTextColumn Header="Valor Atual" Binding="{Binding Valor}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Painel de Edição -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
            <TextBlock Text="Novo Valor:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBox Text="{Binding NovoValor, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="36" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,15,0"/>
            <Button Content="💾 Salvar Alteração" Command="{Binding SalvarParametroCommand}" Width="150" Height="38" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="🔄 Atualizar Lista" Command="{Binding CarregarParametrosCommand}" Width="140" Height="38" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>